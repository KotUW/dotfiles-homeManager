{
  "vim_mode": false,
  "assistant": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "o1-mini"
    },
    "version": "2",
    "dock": "left"
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark Hard",
    "dark": "Ayu Dark"
  },
  "ui_font_size": 17,
  "buffer_font_size": 20,
  // "buffer_font_family": "JetBrains Mono",
  "soft_wrap": "editor_width",
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "notification_panel": {
    "dock": "left"
  },
  "autosave": "on_window_change",
  "journal": {
    "path": "~/w/sync",
    "hour_format": "hour24"
  },
  "jupyter": {
    "kernel_selections": {
      "python": "python3"
    }
  },
  "terminal": {
    // "shell": {
    // "program": "fish"
    // },
    "font_fallbacks": ["Zed Plex Mono"],
    "copy_on_select": true,
    "env": {
      "EDITOR": "zed"
    }
  },
  "show_inline_completions": false,
  "features": {
        "edit_prediction_provider": "zed"
    },

  "inlay_hints": {
    "enabled": true
  },

  "languages": {
    "Perl": {
      "show_inline_completions": true
    },
    "Python": {
      "language_servers": ["basedpyright"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        }
      ]
    }
  },

  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayVariableTypeHints": true
        }
      }
    }
  },
  "auto_update": true
}
