{
  "icon_theme": "Material Icon Theme",
  "vim_mode": false,
  "assistant": {
    "default_model": {
      "provider": "zed.dev",
      "model": "o3-mini"
    },
    "version": "2",
    "dock": "left"
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark Hard",
    "dark": "Catppuccin Mocha"
  },
  "ui_font_size": 17,
  "buffer_font_size": 20,
  // "buffer_font_family": "JetBrains Mono",
  "soft_wrap": "editor_width",
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "notification_panel": {
    "dock": "left"
  },
  "autosave": "on_focus_change",
  "journal": {
    "path": "~/w/sync",
    "hour_format": "hour24"
  },
  // "jupyter": {
  //   "kernel_selections": {
  //     "python": "python3"
  //   }
  // },
  "terminal": {
    "font_fallbacks": ["Zed Plex Mono"],
    "copy_on_select": true,
    "env": {
      "EDITOR": "zed"
    }
  },
  "show_edit_predictions": false,
  "features": {
    "edit_prediction_provider": "zed"
  },

  "inlay_hints": {
    "enabled": true
  },

  "languages": {
    "Perl": {
      "show_edit_predictions": true
    },
    "Python": {
      "language_servers": ["basedpyright"],
      // "language_servers": ["ruff"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    }
  },

  "lsp": {
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayVariableTypeHints": true
        }
      }
    }
  },
  "auto_update": true
}
